# 使用 DeepSeek 示例；也兼容任何 OpenAI-compatible 服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# Render 免费实例建议保持 false，避免冷启动下载模型；本地可开启以展示 BGE 通道。
RAG_ENABLE_DENSE=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DEMO_READ_ONLY=true
RATE_LIMIT_PER_MINUTE=12
# 本地网页端以 SQLite Session 映射受信任 Identity；生产 API 必须改为 production 并配置完整 JWT 材料。
RAG_ENV=development
RAG_ALLOW_INSECURE_DEV_AUTH=false
RAG_DEVELOPMENT_ROLE=engineering
RAG_AUDIT_SALT=replace-with-a-random-local-audit-salt
RAG_JWT_ALGORITHMS=RS256
RAG_JWT_ISSUER=
RAG_JWT_AUDIENCE=
RAG_JWT_JWK_URL=
RAG_JWT_PUBLIC_KEY=
RAG_EVIDENCE_TOKEN_BUDGET=2000
RAG_RETRIEVAL_TIMEOUT_SECONDS=10
RAG_GENERATION_TIMEOUT_SECONDS=20
RAG_TOTAL_TIMEOUT_SECONDS=30
# 本地账户与权限演示。首次登录 admin 后必须立即修改此初始密码。
ADMIN_INITIAL_PASSWORD=Admin@123456
# 默认数据文件已被 .gitignore 忽略；删除该文件可重置所有本地演示账号。
AUTH_DATABASE_PATH=data/rag_demo.sqlite
